# ─────────────────────────────────────────────────────────────
# PORTFOLIO ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# TODO: Your site URL (used for OG tags and sitemap)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# TODO: (Optional) GitHub Personal Access Token for higher API rate limits
# Create one at: https://github.com/settings/tokens
# Only needs public_repo read scope
NEXT_PUBLIC_GITHUB_TOKEN=

# TODO: (Optional) Email API key for contact form
# Recommended: Resend (https://resend.com) — free tier available
RESEND_API_KEY=

# TODO: (Optional) Google Analytics
NEXT_PUBLIC_GA_ID=
